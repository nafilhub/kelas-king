        android:orientation="horizontal"
        android:layout_width="412dp"
        android:layout_height="88dp"
        android:paddingLeft="24dp"
        android:paddingTop="0dp"
        android:paddingRight="24dp"
        android:paddingBottom="0dp">

        <!-- FRAME: Navigation action -->
        <LinearLayout
            android:id="@+id/navigation_action"
            android:orientation="horizontal"
        android:layout_width="42dp"
        android:layout_height="44dp"
            android:background="@drawable/bg_rounded">

            <!-- FRAME: arrow-left -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/arrow_left"
        android:layout_width="22dp"
        android:layout_height="22dp">

                <!-- VECTOR: Vector -->
                <ImageView
                    android:id="@+id/vector"
                    android:src="@drawable/ic_vector"
                    android:scaleType="fitXY"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- FRAME: Page identity -->
        <LinearLayout
            android:id="@+id/page_identity"
            android:orientation="vertical"
        android:layout_width="254dp"
        android:layout_height="40dp">

            <!-- TEXT: Page title -->
            <TextView
                android:id="@+id/page_title"
                android:text="Atur perkuliahan"
                android:textSize="20sp"
                android:textColor="#FF10243B"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="254dp"
        android:layout_height="24dp" />

            <!-- TEXT: Page subtitle -->
            <TextView
                android:id="@+id/page_subtitle"
                android:text="Booking · Langkah 1 dari 2"
                android:textSize="11sp"
                android:textColor="#FF67788A"
                android:gravity="start"
                android:fontFamily="Inter"
        android:layout_width="254dp"
        android:layout_height="13dp" />
        </LinearLayout>

        <!-- FRAME: Help action -->
        <LinearLayout
