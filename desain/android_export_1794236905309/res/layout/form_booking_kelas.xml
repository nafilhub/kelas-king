                        android:orientation="horizontal"
        android:layout_width="177dp"
        android:layout_height="63dp"
                        android:background="@drawable/bg_rounded"
                        android:paddingLeft="12dp"
                        android:paddingTop="12dp"
                        android:paddingRight="12dp"
