                        android:text="Tersedia"
                        android:textSize="11sp"
                        android:textColor="#FFFFFFFF"
                        android:gravity="start"
                        android:fontFamily="Inter"
        android:layout_width="45dp"
        android:layout_height="13dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- FRAME: Course input -->
