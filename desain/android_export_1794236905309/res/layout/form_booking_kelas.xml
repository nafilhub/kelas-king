        android:layout_width="412dp"
        android:layout_height="744dp"
        android:paddingLeft="24dp"
        android:paddingTop="8dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp">

        <!-- FRAME: Booking form -->
