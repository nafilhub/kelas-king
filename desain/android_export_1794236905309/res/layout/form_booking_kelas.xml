                                android:textSize="14sp"
                                android:textColor="#FF10243B"
                                android:gravity="start"
                                android:textStyle="bold"
                                android:fontFamily="Inter"
        android:layout_width="39dp"
        android:layout_height="17dp" />

                            <!-- TEXT: Minutes -->
