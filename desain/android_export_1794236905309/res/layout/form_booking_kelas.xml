                    android:id="@+id/package_row"
                    android:orientation="horizontal"
        android:layout_width="364dp"
        android:layout_height="63dp">

                    <!-- FRAME: SKS package -->
                    <LinearLayout
                        android:id="@+id/sks_package"
                        android:orientation="horizontal"
        android:layout_width="178dp"
        android:layout_height="63dp"
                        android:background="@drawable/bg_rounded"
                        android:paddingLeft="12dp"
                        android:paddingTop="12dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="12dp">

                        <!-- FRAME: Package duration -->
                        <LinearLayout
                            android:id="@+id/package_duration"
                            android:orientation="vertical"
        android:layout_width="130dp"
        android:layout_height="33dp">

                            <!-- TEXT: SKS count -->
                            <TextView
                                android:id="@+id/sks_count"
                                android:text="3 SKS"
                                android:textSize="14sp"
                                android:textColor="#FF007F7B"
                                android:gravity="start"
                                android:textStyle="bold"
                                android:fontFamily="Inter"
        android:layout_width="41dp"
        android:layout_height="17dp" />

                            <!-- TEXT: Minutes -->
                            <TextView
                                android:id="@+id/minutes"
                                android:text="= 150 menit"
                                android:textSize="11sp"
                                android:textColor="#FF67788A"
                                android:gravity="start"
                                android:fontFamily="Inter"
        android:layout_width="62dp"
        android:layout_height="13dp" />
                        </LinearLayout>

                        <!-- FRAME: circle-check -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/circle_check"
        android:layout_width="18dp"
        android:layout_height="18dp">

                            <!-- VECTOR: Vector -->
                            <ImageView
                                android:id="@+id/vector"
                                android:src="@drawable/ic_vector"
                                android:scaleType="fitXY"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
