                                android:id="@+id/minutes"
                                android:text="= 50 menit"
                                android:textSize="11sp"
                                android:textColor="#FF67788A"
                                android:gravity="start"
                                android:fontFamily="Inter"
        android:layout_width="57dp"
        android:layout_height="13dp" />
