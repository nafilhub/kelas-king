                        android:id="@+id/duration_rule"
                        android:text="1 SKS = 50 menit"
                        android:textSize="11sp"
                        android:textColor="#FF67788A"
                        android:gravity="start"
                        android:fontFamily="Inter"
        android:layout_width="89dp"
        android:layout_height="13dp" />
