<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F6F9">

    <!-- Frame: Form booking kelas (412x960) -->

    <!-- FRAME: Android status -->
    <LinearLayout
        android:id="@+id/android_status"
        android:orientation="horizontal"
        android:layout_width="412dp"
        android:layout_height="32dp"
        android:paddingLeft="26dp"
        android:paddingTop="0dp"
        android:paddingRight="26dp"
        android:paddingBottom="0dp">

        <!-- TEXT: Device time -->
        <TextView
            android:id="@+id/device_time"
            android:text="08.44"
            android:textSize="12sp"
            android:textColor="#FF10243B"
            android:gravity="start"
            android:fontFamily="Inter"
        android:layout_width="34dp"
        android:layout_height="15dp" />

        <!-- FRAME: Connectivity -->
        <LinearLayout
            android:id="@+id/connectivity"
            android:orientation="horizontal"
        android:layout_width="57dp"
        android:layout_height="17dp">

            <!-- FRAME: signal -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/signal"
        android:layout_width="14dp"
        android:layout_height="14dp">

                <!-- VECTOR: Vector -->
                <ImageView
                    android:id="@+id/vector"
                    android:src="@drawable/ic_vector"
                    android:scaleType="fitXY"
        android:layout_width="12dp"
        android:layout_height="9dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FRAME: wifi -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wifi"
        android:layout_width="14dp"
        android:layout_height="14dp">

                <!-- VECTOR: Vector -->
                <ImageView
                    android:id="@+id/vector"
                    android:src="@drawable/ic_vector"
                    android:scaleType="fitXY"
        android:layout_width="12dp"
        android:layout_height="9dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FRAME: battery-full -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/battery_full"
        android:layout_width="17dp"
        android:layout_height="17dp">

                <!-- VECTOR: Vector -->
                <ImageView
                    android:id="@+id/vector"
                    android:src="@drawable/ic_vector"
                    android:scaleType="fitXY"
        android:layout_width="14dp"
        android:layout_height="9dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FRAME: App bar -->
    <LinearLayout
