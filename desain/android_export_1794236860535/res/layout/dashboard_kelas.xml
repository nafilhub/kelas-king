                        android:id="@+id/label"
                        android:text="Pilih dari daftar"
                        android:textSize="14sp"
                        android:textColor="#FF10243B"
                        android:gravity="start"
                        android:textStyle="bold"
                        android:fontFamily="Inter"
        android:layout_width="144dp"
        android:layout_height="20dp" />

                    <!-- TEXT: Label -->
                    <TextView
                        android:id="@+id/label"
                        android:text="Cari kelas sebelum tiba"
                        android:textSize="11sp"
                        android:textColor="#FF67788A"
                        android:gravity="start"
                        android:fontFamily="Inter"
        android:layout_width="144dp"
        android:layout_height="16dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

