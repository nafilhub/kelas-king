                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <!-- FRAME: Mode copy -->
                <LinearLayout
                    android:id="@+id/mode_copy"
                    android:orientation="vertical"
        android:layout_width="144dp"
        android:layout_height="40dp">

