                        android:textColor="#FF67788A"
                        android:gravity="start"
                        android:fontFamily="Inter"
        android:layout_width="247dp"
        android:layout_height="15dp" />

                    <!-- TEXT: Field value -->
                    <TextView
                        android:id="@+id/field_value"
                        android:text="09.00–11.30"
